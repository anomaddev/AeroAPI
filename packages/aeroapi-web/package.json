{
  "name": "aeroapi",
  "version": "0.5.0",
  "description": "FlightAware AeroAPI client for browsers and Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomaddev/AeroAPI.git",
    "directory": "packages/aeroapi-web"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test test/client.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
